4:["$","p",null,{"children":["Authors retain copyright of their work and grant EJMI the right of first publication. All articles are published under the",["$","strong",null,{"children":" Creative Commons Attribution (CC BY 4.0) License"}],", permitting unrestricted use, distribution, and reproduction provided the original work is properly cited."]}]
