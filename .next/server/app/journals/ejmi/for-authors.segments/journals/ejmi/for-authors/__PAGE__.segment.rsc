"$","p",null,{"children":"The total word count should not exceed 7000 words, including the title, abstract, main text, references, tables, figures, and supplementary information (where applicable)."}],["$","h6",null,{"className":"fw-semibold mt-4","children":"Article Types"}],["$","ul",null,{"children":[["$","li",null,{"children":"Original Research Articles"}],["$","li",null,{"children":"Review Articles"}],["$","li",null,{"children":"Short Communications"}],["$","li",null,{"children":"Case Studies"}],["$","li",null,{"children":"Opinion Pieces"}],["$","li",null,{"children":"Technical Notes"}]]}],["$","h6",null,{"className":"fw-semibold mt-4","children":"Abstract"}],["$","p",null,{"children":"The abstract should not exceed 300 words and should be structured into background, methodology, results, and conclusions where appropriate."}],["$","h6",null,{"className":"fw-semibold mt-4","children":"Manuscript Structure"}],["$","ol",null,{"children":[["$","li",null,{"children":"Title Page"}],["$","li",null,{"children":"Abstract"}],["$","li",null,{"children":"Keywords"}],["$","li",null,{"children":"Introduction"}],["$","li",null,{"children":"Materials and Methods"}],["$","li",null,{"children":"Results"}],["$","li",null,{"children":"Discussion"}],["$","li",null,{"children":"Conclusion"}],["$","li",null,{"children":"References"}],["$","li",null,{"children":"Acknowledgements (optional)"}]]}],["$","h5",null,{"className":"fw-semibold mt-5","children":"References"}],["$","p",null,{"children":"Authors are required to follow the Vancouver style for referencing. References should be numbered consecutively in the order in which they appear in the text."}],["$","h5",null,{"className":"fw-semibold mt-5","children":"Peer Review"}],["$","p",null,{"children":"All submissions undergo a rigorous double-blind peer review process. Reviewers are selected based on their expertise in the subject area. Editorial decisions are based on reviewers’ comments and academic merit."}],["$","h5",null,{"classN