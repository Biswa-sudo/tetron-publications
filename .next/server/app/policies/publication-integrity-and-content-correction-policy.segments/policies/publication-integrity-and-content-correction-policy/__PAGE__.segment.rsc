0:{"buildId":"wGYpAPwPH8vyX-SpwFgqw","rsc":["$","$1","c",{"children":[[["$","$L2",null,{}],["$","section",null,{"className":"py-4 text-white","style":{"background":"linear-gradient(to right, #2b1c6b, #b4b3e6)"},"children":["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"fw-semibold fs-2","children":"Publication Integrity and Content Correction Policy"}],["$","p",null,{"className":"fs-5 mt-2 mb-0","children":"At Tetron Publications, we adhere to the highest standards of ethical publishing to ensure the accuracy, transparency, and reliability of the content we release. Our operational procedures for handling issues related to errata, retractions, withdrawals, and expressions of concern are designed to maintain the integrity of scientific literature while ensuring that all content is produced and distributed responsibly."}]]}]}],["$","section",null,{"className":"container my-5","children":[["$","h5",null,{"className":"fw-semibold text-primary fs-3","children":"Errata and Corrections"}],["$","p",null,{"className":"fs-5","children":"If a factual error is identified in a published work that does not affect the overall conclusions, we will issue an erratum to correct the mistake. This erratum will clearly explain the correction, and the necessary updates will be made to the article’s DOI and communicated to indexing agencies."}],["$","p",null,{"className":"fs-5","children":"We take corrective action quickly and transparently to maintain the accuracy of the published work."}],["$","h5",null,{"className":"fw-semibold text-primary mt-4 fs-3","children":"Retractions"}],["$","p",null,{"className":"fs-5","children":"In cases where a published work contains serious errors, plagiarism, or misconduct, Tetron Publications will issue a retraction. A retraction is a formal notice that the article is no longer valid, and we will provide a clear explanation for the retraction."}],["$","p",null,{"className":"fs-5","children":"We also ensure that the retracted article remains available online to preserve the scientific record, but with a “retracted” watermark and a link to the retraction statement. Retraction notices will be made prominent, and all changes will be updated in the DOI record and communicated to indexing agencies."}],["$","h5",null,{"className":"fw-semibold text-primary mt-4 fs-3","children":"Process for Retraction"}],["$","p",null,{"className":"fs-5","children":"If an article, post-publication, is retracted, a retraction statement will be issued separately. This statement will explain why the article was retracted and provide details of the issue."}],["$","p",null,{"className":"fs-5","children":"The retracted article and the retraction notice will be clearly linked in the electronic database, ensuring that the retraction is apparent to anyone accessing the original article."}],["$","h5",null,{"className":"fw-semibold text-primary mt-4 fs-3","children":"Withdrawals"}],["$","p",null,{"className":"fs-5","children":"Manuscripts can be withdrawn before or after acceptance, but there are different procedures and conditions based on the timing of the withdrawal:"}],["$","ul",null,{"className":"fs-5","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Before Acceptance:"}]," Authors can withdraw a manuscript without any charge, provided a valid reason is given."]}],["$","li",null,{"children":[["$","strong",null,{"children":"After Acceptance:"}]," If the manuscript is withdrawn after acceptance, a ",["$","strong",null,{"children":"$$100 USD processing fee"}]," will apply. This fee covers administrative and editorial costs associated with the withdrawal process. Authors must provide a valid and detailed reason to ensure transparency and ethical handling."]}]]}],"$L3","$L4","$L5","$L6","$L7","$L8"]}],"$L9"],["$La"],"$Lb"]}],"loading":null,"isPartial":false}
3:["$","h5",null,{"className":"fw-semibold text-primary mt-4 fs-3","children":"Expressions of Concern"}]
4:["$","p",null,{"className":"fs-5","children":"If there are concerns regarding the validity or reliability of a published work, Tetron Publications may issue an expression of concern. This notice will inform readers that the article is under review due to potential issues, though no final decision has been made regarding retraction or correction."}]
5:["$","p",null,{"className":"fs-5","children":"The publisher and editorial team will investigate the issue thoroughly and, if necessary, take appropriate action."}]
6:["$","h5",null,{"className":"fw-semibold text-primary mt-4 fs-3","children":"Complaints and Dispute Resolution"}]
7:["$","p",null,{"className":"fs-5","children":"In cases where an author or other parties wish to challenge a retraction, correction, or related issue, Tetron Publications provides a structured procedure for handling complaints."}]
8:["$","p",null,{"className":"fs-5","children":["Complaints can be submitted directly to Tetron Publications via email at"," ",["$","a",null,{"href":"mailto:support@tetronpublications.com","children":"support@tetronpublications.com"}],". We will conduct a thorough investigation, reviewing all relevant correspondence and gathering additional responses where needed. The goal of the investigation is to ensure that decisions are based on academic criteria and are free from personal bias."]}]
