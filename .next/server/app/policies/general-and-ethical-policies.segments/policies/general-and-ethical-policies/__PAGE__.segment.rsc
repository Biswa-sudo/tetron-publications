0:{"buildId":"wGYpAPwPH8vyX-SpwFgqw","rsc":["$","$1","c",{"children":[[["$","$L2",null,{}],["$","section",null,{"className":"py-3 text-white","style":{"background":"linear-gradient(to right, #2b1c6b, #b4b3e6)"},"children":["$","div",null,{"className":"container","children":["$","h2",null,{"className":"mb-0 fs-2","children":"General and Ethical Policies"}]}]}],["$","section",null,{"className":"container my-5","children":[["$","h5",null,{"className":"fw-semibold text-primary fs-3","children":"Author Instructions"}],["$","p",null,{"className":"fs-5","children":["To access detailed author instructions, please visit the dedicated",["$","em",null,{"children":" Author Instructions"}]," section on the respective journal’s website. For instance, if you wish to submit your work to the",["$","em",null,{"children":" European Journal of Biosciences (EJB)"}],", you can find specific guidelines at ",["$","a",null,{"href":"#","children":"Author Guidelines"}],". Each journal provides tailored guidance to streamline the submission process."]}],["$","h5",null,{"className":"fw-semibold text-primary mt-4 fs-3","children":"Peer-Review Process"}],["$","p",null,{"className":"fs-5","children":"All journals published under our platform follow a rigorous double-blind peer-review process, ensuring that both authors and reviewers remain anonymous to maintain objectivity. Each manuscript is reviewed by a minimum of two experts in the same field, who provide detailed comments and constructive feedback."}],["$","p",null,{"className":"fs-5","children":"This process is overseen by the journal’s Editor, ensuring adherence to the highest standards of academic integrity."}],["$","h5",null,{"className":"fw-semibold text-primary mt-4 fs-3","children":"Ethical Guidelines"}],["$","p",null,{"className":"fs-5","children":"Tetron Publications and its journals are built on a foundation of integrity and ethical publishing practices, ensuring that only the highest-quality manuscripts are selected for publication. We rely on the dedication and honesty of our Editors to uphold the journal’s mission and adhere to the highest ethical standards in scholarly publishing."}],["$","p",null,{"className":"fs-5","children":["Tetron Publications encourages its Editors to follow the"," ",["$","a",null,{"href":"#","children":"Best Practice Guidelines for Journal Editors"}]," as outlined by the Committee on Publication Ethics (COPE)."]}],["$","p",null,{"className":"fs-5","children":["Tetron Publications strictly adheres to professional and industry standards for scientific publications, including the"," ",["$","em",null,{"children":"Recommendations for the Conduct, Reporting, Editing, and Publication of Scholarly Work in Medical Journals (ICMJE)"}]," ","and the"," ",["$","em",null,{"children":"Principles of Transparency and Best Practice in Scholarly Publishing"}],", a joint statement by"," ",["$","a",null,{"href":"#","children":"COPE"}],", ",["$","a",null,{"href":"#","children":"DOAJ"}],", ",["$","a",null,{"href":"#","children":"WAME"}],", and"," ",["$","a",null,{"href":"#","children":"OASPA"}],". These guidelines ensure transparency, accuracy, and the integrity of the scholarly publishing process."]}],["$","h5",null,{"className":"fw-semibold text-primary mt-4 fs-3","children":"Plagiarism"}],["$","p",null,{"className":"fs-5","children":["Plagiarism involves the unethical practice of using another’s ideas, words, or work without proper acknowledgment. This includes presenting existing ideas or content as new and original. Tetron Publications also recognizes ",["$","em",null,{"children":"self-plagiarism"}]," as a violation of ethical standards."]}],["$","p",null,{"className":"fs-5","children":["To maintain the integrity of published work, we utilize advanced plagiarism detection software such as"," ",["$","a",null,{"href":"#","children":"iThenticate"}],", integrated into the manuscript management system for Editors and Reviewers. Manuscripts identified with plagiarized content will be immediately rejected."]}],"$L3","$L4","$L5"]}],"$L6"],["$L7"],"$L8"]}],"loading":null,"isPartial":false}
3:["$","h5",null,{"className":"fw-semibold text-primary mt-4 fs-3","children":"Peer Review"}]
4:["$","p",null,{"className":"fs-5","children":"Tetron Publications employs a robust double-blind peer-review process to ensure the highest quality of published research. In this process, the identities of both authors and reviewers remain anonymous to each other, ensuring impartiality and objectivity."}]
5:["$","p",null,{"className":"fs-5","children":["Our peer-review process strictly adheres to the guidelines established by the Committee on Publication Ethics (COPE). To learn more, please visit ",["$","a",null,{"href":"#","children":"COPE Guidelines"}],". For detailed guidance for reviewers, refer to ",["$","a",null,{"href":"#","children":"Reviewer Guidelines"}],"."]}]
